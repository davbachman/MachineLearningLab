{
  "name": "cs158-ml-assignment-apps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "gradescope:typecheck": "tsc -p gradescope/tsconfig.json",
    "gradescope:bundle": "vite build --config gradescope/vite.config.ts",
    "gradescope:packages": "python3 gradescope/scripts/build_packages.py",
    "gradescope:build": "npm run gradescope:typecheck && npm run gradescope:bundle && npm run gradescope:packages",
    "gradescope:test": "npm run gradescope:build && vitest run --config gradescope/vitest.config.ts && python3 gradescope/scripts/verify_packages.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/fiber": "^9.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.9.6",
    "three": "^0.181.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.0.7",
    "jsdom": "^27.1.0"
  }
}
